{
 "_comment": "Hand-written cases for Spring PetClinic Angular (Angular 22 SPA, Apache-2.0) over spring-petclinic-rest (Java), selectors from `main.py map`; raw selectors only for rows created by the case. expected_outcome is the truth.",
 "test_cases": [
  {
   "test_case_id": "TC-NG-001",
   "title": "Find owners by last name lists the matching owner",
   "module": "PetClinic",
   "test_type": "functional",
   "priority": "high",
   "expected_outcome": "PASS",
   "automation_steps": [
    {
     "playwright_action": "navigate",
     "value": "/petclinic/owners"
    },
    {
     "playwright_action": "fill",
     "selector_key": "last_name",
     "value": "Davis"
    },
    {
     "playwright_action": "click",
     "selector_key": "find_owner_button"
    },
    {
     "playwright_action": "assert",
     "selector_key": "page",
     "assertion_type": "text",
     "assertion_value": "Betty Davis"
    },
    {
     "playwright_action": "assert",
     "selector_key": "page",
     "assertion_type": "text",
     "assertion_value": "Harold Davis"
    }
   ]
  },
