   "test_case_id": "TC-NG-006",
   "title": "Adding a vet lists the vet",
   "module": "PetClinic",
   "test_type": "functional",
   "priority": "high",
   "expected_outcome": "PASS",
   "automation_steps": [
    {
     "playwright_action": "navigate",
     "value": "/petclinic/vets/add"
    },
    {
     "playwright_action": "fill",
     "selector_key": "#firstName",
     "value": "Vet"
    },
    {
     "playwright_action": "fill",
     "selector_key": "#lastName",
     "value": "Qax{{unique_letters}}"
    },
    {
     "playwright_action": "click",
     "selector_key": "button:has-text('Save Vet')"
    },
    {
     "playwright_action": "assert",
     "assertion_type": "url",
     "assertion_value": "/petclinic/vets"
    },
    {
     "playwright_action": "assert",
     "selector_key": "page",
     "assertion_type": "text",
     "assertion_value": "Vet Qax{{unique_letters}}"
    }
   ]
  },
  {
   "test_case_id": "TC-NG-007",
   "title": "Deleting a vet removes them from the list",
   "module": "PetClinic",
   "test_type": "functional",
   "priority": "high",
   "expected_outcome": "PASS",
   "automation_steps": [
    {
     "playwright_action": "navigate",
     "value": "/petclinic/vets/add"
    },
    {
     "playwright_action": "fill",
     "selector_key": "#firstName",
     "value": "Vet"
    },
    {
     "playwright_action": "fill",
     "selector_key": "#lastName",
     "value": "Qax{{unique_letters}}"
    },
    {
     "playwright_action": "click",
     "selector_key": "button:has-text('Save Vet')"
    },
    {
     "playwright_action": "click",
     "selector_key": "xpath=//tr[*[normalize-space(.)='Vet Qax{{unique_letters}}']]//button[normalize-space(.)='Delete Vet']"
    },
    {
     "playwright_action": "assert",
     "selector_key": "xpath=//tr[*[normalize-space(.)='Vet Qax{{unique_letters}}']]",
     "assertion_type": "not_visible"
    }
   ]
  },
