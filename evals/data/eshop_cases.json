   "test_case_id": "TC-ES-004",
   "title": "Changing the quantity updates the total",
   "module": "Shop",
   "test_type": "functional",
   "priority": "high",
   "expected_outcome": "PASS",
   "automation_steps": [
    {
     "playwright_action": "navigate",
     "value": "/"
    },
    {
     "playwright_action": "click",
     "selector_key": "add_to_basket_roslyn_red_sheet_button"
    },
    {
     "playwright_action": "assert",
     "assertion_type": "url",
     "assertion_value": "/Basket"
    },
