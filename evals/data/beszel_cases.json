{
  "_comment": "Functional QA on a real SPA: Beszel hub v0.21.0 (MIT, React + Radix, PocketBase backend; its own UI), run locally. Selector keys from `main.py map --explore-actions`; dialog/menu items named live (exact names); row actions scoped with a Playwright selector. Includes create / edit / pause / delete (confirm) / logout. Credentials: QAX_VAR_BZ_USER / QAX_VAR_BZ_PASSWORD.",
  "test_cases": [
    {
      "test_case_id": "BZ-001",
      "title": "Valid login opens the systems dashboard",
      "module": "Systems",
      "priority": "high",
      "expected_outcome": "PASS",
      "automation_steps": [
        {
          "playwright_action": "navigate",
          "value": "/",
          "step_number": 1
        },
        {
          "playwright_action": "fill",
          "selector_key": "email",
          "value": "{{env:QAX_VAR_BZ_USER}}",
          "step_number": 2
        },
        {
          "playwright_action": "fill",
          "selector_key": "password",
          "value": "{{env:QAX_VAR_BZ_PASSWORD}}",
          "step_number": 3
        },
        {
          "playwright_action": "click",
          "selector_key": "sign_in_button",
          "step_number": 4
        },
        {
          "playwright_action": "assert",
          "selector_key": "add_system_button",
          "assertion_type": "visible",
          "step_number": 5
        }
      ]
    },
    {
