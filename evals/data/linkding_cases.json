{
  "_comment": "Functional QA on a real app: linkding 1.47.0 (MIT), run locally. Credentials come from QAX_VAR_LD_USER / QAX_VAR_LD_PASSWORD \u2014 never stored here. expected_outcome = linkding's real, manually verified behaviour. Each case stands alone (creates its own data); text checks use the built-in `page` key, so only discovered selectors are needed.",
  "test_cases": [
    {
      "test_case_id": "LD-001",
      "title": "Valid login opens the bookmarks page",
      "module": "Bookmarks",
      "priority": "high",
      "expected_outcome": "PASS",
      "automation_steps": [
        {
          "playwright_action": "navigate",
          "value": "/login/",
          "step_number": 1
        },
        {
          "playwright_action": "fill",
          "selector_key": "username",
          "value": "{{env:QAX_VAR_LD_USER}}",
          "step_number": 2
        },
        {
          "playwright_action": "fill",
          "selector_key": "password",
          "value": "{{env:QAX_VAR_LD_PASSWORD}}",
          "step_number": 3
        },
        {
          "playwright_action": "click",
          "selector_key": "login_button",
          "step_number": 4
        },
        {
          "playwright_action": "assert",
          "assertion_type": "url",
          "assertion_value": "/bookmarks",
          "step_number": 5
        }
      ]
    },
    {
