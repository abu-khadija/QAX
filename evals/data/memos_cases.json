{
  "_comment": "Functional QA on a real SPA: Memos v0.31.0 (MIT, React + Base UI, Connect RPC), run locally. Selector keys from `main.py map --explore-actions`; menu items (role=menuitem) and the confirm dialog are named live (exact names). Includes create / delete (submenu + confirm dialog) / archive / sign out. Credentials: QAX_VAR_ME_USER / QAX_VAR_ME_PASSWORD.",
  "test_cases": [
    {
      "test_case_id": "ME-001",
      "title": "Valid login opens the memo timeline",
      "module": "Memos",
      "priority": "high",
      "expected_outcome": "PASS",
      "automation_steps": [
        {
          "playwright_action": "navigate",
          "value": "/auth",
          "step_number": 1
        },
        {
          "playwright_action": "fill",
          "selector_key": "username",
          "value": "{{env:QAX_VAR_ME_USER}}",
          "step_number": 2
        },
        {
          "playwright_action": "fill",
          "selector_key": "password",
          "value": "{{env:QAX_VAR_ME_PASSWORD}}",
          "step_number": 3
        },
        {
          "playwright_action": "click",
          "selector_key": "sign_in_button",
          "step_number": 4
        },
        {
          "playwright_action": "assert",
          "selector_key": "new_memo_button",
          "assertion_type": "visible",
          "step_number": 5
        }
      ]
    },
