        {
          "playwright_action": "navigate",
          "value": "/auth/login",
          "step_number": 1
        },
        {
          "playwright_action": "fill",
          "selector_key": "username",
          "value": "{{env:QAX_VAR_MB_USER}}",
          "step_number": 2
        },
        {
          "playwright_action": "fill",
          "selector_key": "password",
          "value": "{{env:QAX_VAR_MB_PASSWORD}}",
          "step_number": 3
        },
