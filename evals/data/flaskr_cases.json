{
  "_comment": "Functional QA on a real app: Flaskr (Flask's official tutorial, BSD-3) @ pallets/flask d086db8, run locally. Selector keys from `main.py map --explore-actions`; the edit page is named live (exact names). Includes create / edit / delete (confirm dialog) / logout. Credentials: QAX_VAR_FL_USER / QAX_VAR_FL_PASSWORD.",
  "test_cases": [
    {
      "test_case_id": "FL-001",
      "title": "A new user can register and is sent to log in",
      "module": "Blog",
      "priority": "high",
      "expected_outcome": "PASS",
      "automation_steps": [
        {
          "playwright_action": "navigate",
          "value": "/auth/register",
          "step_number": 1
        },
        {
          "playwright_action": "fill",
          "selector_key": "username",
          "value": "qax_{{unique}}",
          "step_number": 2
        },
        {
          "playwright_action": "fill",
          "selector_key": "password",
          "value": "pw-{{unique}}",
          "step_number": 3
        },
        {
          "playwright_action": "click",
          "selector_key": "register_button",
          "step_number": 4
        },
        {
          "playwright_action": "assert",
          "assertion_type": "url",
          "assertion_value": "/auth/login",
          "step_number": 5
        }
      ]
    },
