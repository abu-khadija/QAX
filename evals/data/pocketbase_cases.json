{
  "_comment": "Functional QA on a real SPA: PocketBase v0.40.5 (MIT) dashboard, run locally. Selector keys come from `main.py map` (no hand-written selectors). Credentials: QAX_VAR_PB_USER / QAX_VAR_PB_PASSWORD.",
  "test_cases": [
    {
      "test_case_id": "PB-001",
      "title": "Valid login opens the collections",
      "module": "Dashboard",
      "priority": "high",
      "expected_outcome": "PASS",
      "automation_steps": [
        {
          "playwright_action": "navigate",
          "value": "/_/",
          "step_number": 1
        },
        {
          "playwright_action": "fill",
          "selector_key": "email",
          "value": "{{env:QAX_VAR_PB_USER}}",
          "step_number": 2
        },
        {
          "playwright_action": "fill",
          "selector_key": "password",
          "value": "{{env:QAX_VAR_PB_PASSWORD}}",
          "step_number": 3
        },
        {
          "playwright_action": "click",
          "selector_key": "login_button",
          "step_number": 4
        },
        {
          "playwright_action": "assert",
          "assertion_type": "url",
          "assertion_value": "#/collections",
          "step_number": 5
        }
      ]
    },
    {
      "test_case_id": "PB-002",
