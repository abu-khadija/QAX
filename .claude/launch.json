{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "qax-web",
      "runtimeExecutable": "./.venv-exec/bin/python",
      "runtimeArgs": [
        "-m",
        "web.server"
      ],
      "port": 8900
    },
    {
      "name": "ui-demo-app",
      "runtimeExecutable": "./.venv-exec/bin/python",
      "runtimeArgs": [
        "evals/targets/ui_demo_app.py",
        "--port",
        "8911"
      ],
      "port": 8911
    },
    {
      "name": "vuln-target",
      "runtimeExecutable": "./.venv-exec/bin/python",
      "runtimeArgs": [
        "-c",
        "import os,runpy; os.environ['PORT']='8920'; runpy.run_path('evals/targets/vuln_jwt_app.py', run_name='__main__')"
      ],
      "port": 8920
    }
  ]
}