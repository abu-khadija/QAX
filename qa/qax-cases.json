{
  "test_cases": [
    {
      "test_case_id": "TC-UI-001",
      "title": "Valid login opens the dashboard",
      "module": "Notes",
      "test_type": "functional",
      "priority": "high",
      "expected_outcome": "PASS",
      "automation_steps": [
        {
          "playwright_action": "navigate",
          "value": "/login",
          "step_number": 1
        },
        {
          "playwright_action": "fill",
          "selector_key": "username",
          "value": "demo",
          "step_number": 2
        },
        {
          "playwright_action": "fill",
          "selector_key": "password",
          "value": "demo123",
          "step_number": 3
        },
        {
          "playwright_action": "click",
          "selector_key": "login_button",
          "step_number": 4
        },
        {
          "playwright_action": "assert",
          "selector_key": "welcome_heading",
          "assertion_type": "text",
          "assertion_value": "Welcome, demo",
          "step_number": 5
        },
        {
          "playwright_action": "assert",
          "assertion_type": "url",
          "assertion_value": "/dashboard",
          "step_number": 6
        }
      ]
    },
    {
      "test_case_id": "TC-UI-002",
