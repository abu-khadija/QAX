# ═══════════════════════════════════
# QAX — Environment Configuration
# Copy this file to .env and fill in
# ═══════════════════════════════════

# ── Claude AI (REQUIRED) ──────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Jira (REQUIRED for Jira modes) ─
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token
# Get token from: id.atlassian.com → Security → API tokens

# ── Jira Cloud ID ────────────────
JIRA_CLOUD_ID=your-cloud-id-here
# Find it at: your-domain.atlassian.net/_edge/tenant_info

# ── Jira Project ─────────────────
JIRA_PROJECT_KEY=YOUR_PROJECT
# The short key shown in Jira (e.g. MYAPP, EXAMPLE, PROJ)

# ── Xray (REQUIRED for pushing test cases) ─
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret
# Get from: Jira → Apps → Xray → API Keys

# ── Project defaults ─────────────
DEFAULT_PROJECT=example
# Must match a folder name in config/projects/

# ── Safety ───────────────────────
DRY_RUN=true
# Keep true until you are ready to push to Jira

# ── Model selection ──────────────
CLAUDE_MODEL_HEAVY=claude-sonnet-4-5
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
# Heavy: complex files (200+ lines) or high git-risk files
# Light: simple files < 150 lines, low risk (saves ~80% cost)

# ── Screenshot capture (optional) ─
ENABLE_SCREENSHOT=false
APP_BASE_URL=https://your-app-url.com
APP_USERNAME=your-username
APP_PASSWORD=your-password
APP_LOGIN_URL=https://your-app.com/login

# ── Bug Reporter ─────────────────
AUTO_BUG_REPORT=true
JIRA_SEVERITY_FIELD=severity
JIRA_ENVIRONMENT_FIELD=environment
# Note: severity and environment field names may differ per Jira instance.
# Check: Jira → Project Settings → Fields to find exact custom field names or IDs.
# Some instances use: customfield_10016 for severity.

# ── GitHub (for PR input adapter) ────────────
GITHUB_TOKEN=your-github-token
GITHUB_REPO=owner/repo-name
# Used by: python main.py pipeline --input pr --source 142

# ── Zephyr Scale (optional, for ZephyrAdapter) ─
ZEPHYR_API_TOKEN=your-zephyr-api-token
ZEPHYR_PROJECT_KEY=YOUR_PROJECT
# Get token from: Jira → Apps → Zephyr Scale → API Keys
# Project key must match the Jira project key (e.g. MYAPP, PROJ)

# ── Dashboard ────────────────────
DASHBOARD_PORT=5000

# ── Logging ──────────────────────
LOG_LEVEL=INFO

# ── AI provider for writing test cases (optional; default Anthropic) ─────────
# Any OpenAI-compatible chat API, including a LOCAL model (the story and code stay on this machine):
# QAX_AI_PROVIDER=openai
# QAX_AI_BASE_URL=http://localhost:11434/v1     # Ollama; or https://api.openai.com/v1, Azure, LM Studio, vLLM
# QAX_AI_MODEL=llama3.1:70b
# QAX_AI_API_KEY=

# Web UI: seconds a request waits for the browser (another run or app read) before answering 409 "busy"
# QAX_BROWSER_WAIT=5
# Run generated cases that use an element QAX did not find on the app (default: held back until reviewed)
# QAX_ALLOW_UNMAPPED=false
# Accessibility engine for page observations: basic (built-in checks) or axe (Deque axe-core 4.13.0, WCAG A/AA)
# QAX_A11Y=basic
