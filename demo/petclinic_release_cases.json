   "test_case_id": "TC-PC-001",
   "title": "Find owners by last name lists the matching owner",
   "module": "Owners",
   "test_type": "functional",
   "priority": "high",
   "automation_steps": [
    {
     "playwright_action": "navigate",
     "value": "/owners/find"
    },
    {
     "playwright_action": "fill",
